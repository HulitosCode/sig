generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  // FRETA: papel da conta
  role String @default("motorista") // "admin" | "motorista" | "cliente"

  motorista Motorista?
  sessions  Session[]
  accounts  Account[]
  contactos Contacto[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now())

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// FRETA — domínio
// ---------------------------------------------------------------------------

model Motorista {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Base do motorista: província (seleccionada no cadastro) + praça.
  // Default só para linhas antigas — o formulário sempre envia a província.
  provincia     String @default("Maputo")
  // Rota opcional que o motorista vai fazer (ex.: de Maputo para Matola) —
  // pedidos com origem/destino compatíveis são priorizados na distribuição.
  rotaOrigem    String?
  rotaDestino   String?

  fotoUrl        String?
  telefone       String // usado no botão "Ligar"
  whatsapp       String? // usado no botão "WhatsApp" (fallback: telefone)
  praca          String // praça/zona: Maputo, Matola, Zimpeto...
  tipoViatura    String // tipo de carro: carrinha, camião, pick-up...
  modelo         String? // ex.: Toyota Dyna
  ano            Int? // ano de fabrico
  matricula      String
  cargaMax       String // ex.: "2 toneladas"
  servicos       String[] // mudanca | mercadoria | moveis | construcao | pesada | outro
  precoKm        String?
  observacoes    String?

  // Documentos e fotos (verificação de identidade/veículo)
  biFrenteUrl     String? // BI — frente
  biVersoUrl      String? // BI — verso
  fotoFrenteUrl   String? // foto do carro — frente
  fotoEsquerdaUrl String? // foto do carro — lado esquerdo
  fotoDireitaUrl  String? // foto do carro — lado direito
  fotoTraseiraUrl String? // foto do carro — traseira

  status          String @default("pendente") // pendente | ativo | bloqueado
  disponibilidade String @default("disponivel") // disponivel | ocupado | indisponivel

  // Ciclo de verificação (submissão → validação do admin)
  documentosEnviadosEm DateTime?
  verificadoEm         DateTime?
  verificadoPor        String? // userId do admin que aprovou
  rejeicaoMotivo       String? // motivo da última rejeição

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagamentos Pagamento[]
  avaliacoes Avaliacao[]
  pedidos    Pedido[]
  contactos  Contacto[]
}

model Pagamento {
  id           Int      @id @default(autoincrement())
  motoristaId  Int
  motorista    Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  valor        Int       @default(480) // MT/mês (plano mensal)
  status       String    @default("pendente") // pendente | confirmado
  pagoEm       DateTime?
  confirmadoPor String? // userId do admin
  validoAte    DateTime? // fim do período pago
  criadoEm     DateTime  @default(now())

  @@index([motoristaId])
}

model Pedido {
  id             Int        @id @default(autoincrement())

  tipoCarga      String // mudanca | mercadoria | moveis | construcao | pesada | outro
  praca          String // praça de origem (para filtrar motoristas)
  pracaDestino   String? // praça/destino estruturado (opcional) — matching de rota
  origem         String // detalhe da origem (bairro, rua)
  destino        String // para onde vai
  veiculoSugerido String?
  contacto       String? // telefone opcional do cliente

  // Ciclo de vida: aberto → em_curso (motorista entrou em contacto) →
  // concluido; "não deu certo" volta a aberto para outros motoristas.
  status         String     @default("aberto") // aberto | em_curso | concluido | cancelado
  motoristaId    Int?       // motorista com o pedido em curso
  motorista      Motorista? @relation(fields: [motoristaId], references: [id], onDelete: SetNull)
  atribuidoEm    DateTime?
  concluidoEm    DateTime?
  tentativas     Int        @default(0) // motoristas que já entraram em contacto

  criadoEm       DateTime  @default(now())

  avaliacoes Avaliacao[]

  @@index([praca, criadoEm])
  @@index([motoristaId])
}

model Avaliacao {
  id          Int       @id @default(autoincrement())
  motoristaId Int
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  pedidoId    Int?
  pedido      Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  nota        Int // 1..5
  comentario  String?
  criadoEm    DateTime  @default(now())

  @@index([motoristaId])
}

// Histórico de contactos do cliente: regista que um cliente (sessão iniciada)
// ligou/mandou mensagem a um motorista. Alimenta o painel do cliente
// ("motoristas com quem já entrou em contacto"). Um registo por par
// cliente+motorista — contactos repetidos actualizam o canal e a data.
model Contacto {
  id           Int       @id @default(autoincrement())
  clienteId    String
  cliente      User      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  motoristaId  Int
  motorista    Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade)
  pedidoId     Int? // pedido da pesquisa que originou o contacto (opcional)
  canal        String // telefone | whatsapp
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@unique([clienteId, motoristaId])
  @@index([motoristaId])
}
