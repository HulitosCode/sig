# Banco de dados (docker-compose: user=freta, db=freta)
DATABASE_URL="postgresql://freta:freta-pass@localhost:5432/freta"

# Better Auth
BETTER_AUTH_SECRET="troque-este-segredo-por-um-valor-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SMTP (opcional em dev — sem estas variáveis os emails são ignorados)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_EMAIL=""
SMTP_PASSWORD=""

# Admin inicial (usado pelo seed)
ADMIN_EMAIL="admin@freta.co.mz"
ADMIN_SENHA="admin123"
