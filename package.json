{
  "name": "levafacil",
  "version": "1.0.0",
  "private": true,
  "description": "LevaFacil - plataforma que conecta fornecedores e transportadores em Moçambique",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:setup": "prisma db push && tsx src/seed.ts",
    "test:api": "tsx src/test_api.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "prisma": "^5.22.0",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
