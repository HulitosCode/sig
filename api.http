@baseUrl = http://localhost:3000

### Autenticação

# GET /api/health
# Verifica se a API está a correr.
GET {{baseUrl}}/api/health

### POST /api/auth/registar
# Cria conta de transportador. O token devolvido é necessário nas rotas /api/transportador.
# @name registoTransportador
POST {{baseUrl}}/api/auth/registar
Content-Type: application/json

{
  "nome": "Rute Macamo",
  "email": "rute@teste.co.mz",
  "telefone": "+258 84 999 9991",
  "whatsapp": "+258 84 999 9991",
  "senha": "123456",
  "tipo": "transportador"
}

### POST /api/auth/registar
# Cria conta de fornecedor. O token devolvido é necessário nas rotas /api/fornecedor.
# @name registoFornecedor
POST {{baseUrl}}/api/auth/registar
Content-Type: application/json

{
  "nome": "Supermercado Kwanza, Lda",
  "email": "kwanza@teste.co.mz",
  "telefone": "+258 82 999 9992",
  "whatsapp": "+258 82 999 9992",
  "senha": "123456",
  "tipo": "fornecedor"
}

### POST /api/auth/entrar
# Login de transportador (utilizador do seed: senha 123456). Copia o token para a variável tokenTransportador abaixo.
# @name entrarTransportador
POST {{baseUrl}}/api/auth/entrar
Content-Type: application/json

{
  "email": "joao@exemplo.co.mz",
  "senha": "123456"
}

### POST /api/auth/entrar
# Login de fornecedor (utilizador do seed: senha 123456).
# @name entrarFornecedor
POST {{baseUrl}}/api/auth/entrar
Content-Type: application/json

{
  "email": "nhamatanda@exemplo.co.mz",
  "senha": "123456"
}

### GET /api/me
# Dados do utilizador autenticado (exige Authorization).
GET {{baseUrl}}/api/me
Authorization: Bearer {{registroTransportador.response.body.data.token}}

### Perfis

### POST /api/transportador
# Regista/atualiza o perfil de transportador (exige token de transportador).
POST {{baseUrl}}/api/transportador
Authorization: Bearer {{registroTransportador.response.body.data.token}}
Content-Type: application/json

{
  "bi": "2000456T",
  "tipoCarro": "Camião 4 eixos",
  "categoria": "Camiões",
  "matricula": "RMC-456-MZ",
  "cargaMax": "18.000 kg",
  "precoKm": "14",
  "viagemLonga": "sim",
  "zonas": "Maputo, Gaza, Inhambane",
  "obs": "Longo curso, materiais de construção."
}

### POST /api/fornecedor
# Regista/atualiza o perfil de fornecedor (exige token de fornecedor).
POST {{baseUrl}}/api/fornecedor
Authorization: Bearer {{registroFornecedor.response.body.data.token}}
Content-Type: application/json

{
  "nif": "500987654",
  "provincia": "Maputo",
  "produtos": "Alimentos e bebidas",
  "obs": "Entregas diárias na cidade de Maputo."
}

### Marketplace (público)

### GET /api/transportadores
# Lista transportadores confirmados (público).
GET {{baseUrl}}/api/transportadores

### GET /api/fornecedores
# Lista fornecedores confirmados (público).
GET {{baseUrl}}/api/fornecedores

### Administração

### POST /api/admin/entrar
# Login de administrador. Copia o token para as variáveis adminToken* abaixo.
# @name adminEntrar
POST {{baseUrl}}/api/admin/entrar
Content-Type: application/json

{
  "email": "admin@levafacil.co.mz",
  "senha": "admin123"
}

### GET /api/admin/pendentes
# Lista perfis pendentes de aprovação (exige token de admin).
GET {{baseUrl}}/api/admin/pendentes
Authorization: Bearer {{adminEntrar.response.body.data.token}}

### GET /api/admin/confirmados
# Lista perfis confirmados (exige token de admin).
GET {{baseUrl}}/api/admin/confirmados
Authorization: Bearer {{adminEntrar.response.body.data.token}}

### POST /api/admin/pagamento/:tipo/:id
# Marca pagamento como efetuado (substituir :id pelo id do registo pendente). Exige token de admin.
POST {{baseUrl}}/api/admin/pagamento/transportador/1
Authorization: Bearer {{adminEntrar.response.body.data.token}}

### POST /api/admin/confirmar/:tipo/:id
# Confirma o perfil (status confirmado + pagamento). Exige token de admin.
POST {{baseUrl}}/api/admin/confirmar/fornecedor/1
Authorization: Bearer {{adminEntrar.response.body.data.token}}

### DELETE /api/admin/remover/:tipo/:id
# Remove o perfil (cuidado: remove também o utilizador). Exige token de admin.
DELETE {{baseUrl}}/api/admin/remover/transportador/1
Authorization: Bearer {{adminEntrar.response.body.data.token}}
